*.tmp
*.temp
*.bak
*.swp
*~

# Database files (if using local storage in unexpected locations)
*.db
*.db-journal

# Auto-improve reports
.auto_improve_reports/

# Changelogs (auto-generated, not for version control)
.changelogs/
changelogs/

# Hermes
.hermes/


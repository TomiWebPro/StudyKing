# StudyKing Environment Variables
# Pass these with --dart-define when running or building:
#   flutter run --dart-define=OPENROUTER_API_KEY=sk-...
#   flutter build apk --dart-define=APP_ENV=production

# === API Keys ===
OPENROUTER_API_KEY=
GOOGLE_API_KEY=
WHISPER_API_KEY=

# === Environment ===
# Set to 'production' for release builds, 'development' for debug
APP_ENV=development

# === Version Info ===
APP_VERSION=1.0.0
APP_BUILD_NUMBER=1

# === Security ===
# Encryption key for local data at rest (must be >= 32 characters)
STUDYKING_ENCRYPTION_KEY=

# === Feature Flags ===
# Set to 'true' to allow unauthenticated mode (debug only)
ALLOW_UNAUTHENTICATED_MODE=false

# === Default Model Overrides ===
# Override default LLM models per provider
# DEFAULT_OPENROUTER_MODEL=gemini-2.0-flash
# DEFAULT_OLLAMA_MODEL=llama3
# DEFAULT_OPENAI_MODEL=gpt-4o-mini

# === API Base URL Overrides ===
# Override default API base URLs for local/self-hosted setups
# OLLAMA_BASE_URL=http://localhost:11434
# OPENAI_BASE_URL=https://api.openai.com/v1

# === E2E Test (opt-in) ===
# Ailab grant-model e2e harness under test/integration/agentic_e2e/.
# These are intentionally SEPARATE from the runtime overrides above: they
# select the LLM used only for offline-period agentic behaviour tests that
# audit grant-model token spend against the prep-vs-live economy
# (see docs/vision_next_term.md §2). Defaults to OFF in CI — tests skip
# cleanly when these are absent (no keys hardcoded, no real network calls).
#
#   flutter test test/integration/agentic_e2e/ailab_model_e2e_test.dart \
#     --dart-define=STUDYKING_E2E_MODEL=gemini-2.0-flash \
#     --dart-define=OPENROUTER_API_KEY=sk-... \
#     --dart-define=STUDYKING_E2E_BASE_URL=https://openrouter.ai/api/v1
#
# Required: the grant-model e2e tests use LlmProvider.openRouter, so
# OPENROUTER_API_KEY is reused for auth. Set STUDYKING_E2E_MODEL to the
# target model (e.g. gemini-2.0-flash).
STUDYKING_E2E_MODEL=
# Optional. Overrides the API base URL for self-hosted / ailab grant
# endpoints. When empty, the provider's standard endpoint is used.
STUDYKING_E2E_BASE_URL=
